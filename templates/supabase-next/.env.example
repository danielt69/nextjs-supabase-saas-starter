# =============================================================================
# nextjs-supabase-saas-starter — environment variables
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` or real secrets. Placeholders only live here.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
# Public values, safe to expose to the browser (prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Bypasses Row Level Security.
# Never expose to the client. Used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Encryption -------------------------------------------------------------
# Used to encrypt BYOK provider API keys at rest before storing them.
# Generate a strong 32-byte key, e.g.:  openssl rand -base64 32
BYOK_ENCRYPTION_KEY=replace-with-a-32-byte-base64-secret

# --- Google OAuth (optional) ------------------------------------------------
# Configure the Google provider in: Supabase Dashboard > Authentication > Providers.
# Supabase performs the OAuth exchange; these are documented here for reference
# and for any custom server-side flows you add.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# --- App --------------------------------------------------------------------
# Public base URL of the app. Used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
