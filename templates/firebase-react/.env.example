# Firebase web app config — copy this file to .env.local and fill in the values.
# Find these in Firebase Console → Project settings → Your apps → SDK setup.
# These VITE_ variables are exposed to the browser (Firebase web config is public
# by design — security is enforced by Firestore rules, not by hiding the config).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
