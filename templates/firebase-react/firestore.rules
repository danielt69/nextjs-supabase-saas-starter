rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projects are owned by the user identified in the document's userId field.
    match /projects/{projectId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId;
    }

    // The BYOK provider key document id is the user's uid, so only the owner
    // can read or write their own encrypted key.
    match /providerKeys/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
