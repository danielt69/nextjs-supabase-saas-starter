# =============================================================================
# t3-saas-starter — environment variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` or real secrets. Placeholders only live here.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite for local dev (zero config). For PostgreSQL, change the datasource
# provider in prisma/schema.prisma to "postgresql" and use a Postgres URL.
DATABASE_URL="file:./dev.db"

# --- NextAuth (Auth.js) -----------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-secret-min-32-chars

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Encryption -------------------------------------------------------------
# Encrypts BYOK provider API keys at rest. Generate with: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=replace-with-a-32-byte-base64-secret

# --- LLM (optional) ---------------------------------------------------------
# Override to use a different OpenAI-compatible provider / model.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
