# =============================================================================
# react-convex-clerk-saas-starter — environment variables
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` or real secrets. Placeholders only live here.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Server-only secrets (CLERK_SECRET_KEY, BYOK_ENCRYPTION_KEY) are set in the
# Convex dashboard, NOT in this file — see the README.
# =============================================================================

# --- Convex (browser) -------------------------------------------------------
# Written automatically by `npx convex dev` the first time you run it.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# --- Clerk (browser) --------------------------------------------------------
# Clerk Dashboard > API keys. Publishable key is public.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# --- Server-side (set these in the Convex dashboard, not here) ---------------
# Convex Dashboard > Settings > Environment Variables:
#   CLERK_JWT_ISSUER_DOMAIN  your Clerk Frontend API URL, e.g.
#                            https://your-subdomain.clerk.accounts.dev
#   BYOK_ENCRYPTION_KEY      a strong secret, e.g. `openssl rand -base64 32`
# Listed here for reference only:
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_JWT_ISSUER_DOMAIN=https://your-subdomain.clerk.accounts.dev
BYOK_ENCRYPTION_KEY=replace-with-a-32-byte-base64-secret
