# =============================================================================
# convex-clerk-saas-starter — environment variables
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` or real secrets. Placeholders only live here.
# =============================================================================

# --- Convex -----------------------------------------------------------------
# Created by running `npx convex dev` the first time. It writes the deployment
# URL here automatically. Public, safe to expose to the browser.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Clerk ------------------------------------------------------------------
# Found in: Clerk Dashboard > API keys.
# Publishable key is public (prefixed NEXT_PUBLIC_). Secret key is SERVER ONLY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Clerk JWT issuer domain — your Clerk Frontend API URL.
# Found in: Clerk Dashboard > JWT Templates > (create a "convex" template),
# or Clerk Dashboard > API keys > "Frontend API URL".
# Used by Convex (convex/auth.config.ts) to validate Clerk access tokens.
# Set the SAME value in the Convex dashboard as CLERK_JWT_ISSUER_DOMAIN.
CLERK_JWT_ISSUER_DOMAIN=https://your-subdomain.clerk.accounts.dev

# Where Clerk sends users for sign in / sign up (these routes ship in the app).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Encryption -------------------------------------------------------------
# Used to encrypt BYOK provider API keys at rest before storing them in Convex.
# Generate a strong 32-byte key, e.g.:  openssl rand -base64 32
BYOK_ENCRYPTION_KEY=replace-with-a-32-byte-base64-secret
